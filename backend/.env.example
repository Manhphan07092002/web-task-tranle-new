# =============================================
# BACKEND .env.example - Copy thành backend/.env và điền giá trị
# Xem bản production đầy đủ ở .env.production.example (thư mục root)
# =============================================
PORT=3500
NODE_ENV=development

# ── Database (MySQL 8, duy nhất - không còn SQLite) ──
MYSQL_DATABASE=Tranle_task_new
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306
DATABASE_URL=mysql://root:@127.0.0.1:3306/Tranle_task_new

# ── Security Keys (production bắt buộc ≥ độ dài tối thiểu, xem server.ts fail-fast) ──
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MAIL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_DEFAULT_PASSWORD=TranLe@dmin2026!
APP_BASE_URL=http://localhost:3500
ALLOWED_ORIGIN=http://localhost:5173

# ── SMTP Mail Configuration (tùy chọn) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── AI (qua backend /api/ai - KHÔNG đặt key vào biến VITE_*) ──
GEMINI_API_KEY=
SEED_DEMO_DATA=false

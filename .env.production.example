# ── Server & Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3500

# ── Database (MySQL) ─────────────────────────────────────────────────────────
MYSQL_DATABASE=Tranle_task_new
MYSQL_USER=tranle
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_PORT=3306
DATABASE_URL=mysql://tranle:change-me-to-a-strong-password@localhost:3306/Tranle_task_new
# Demo catalog/project/task seeds are disabled by default in production.
# Set SEED_DEMO_DATA=true only for an intentional demo environment.
# Seeds run only on first installation; this flag never reseeds an existing database.

# ── Security Keys (BẮT BUỘC thay đổi khi triển khai) ──────────────────────────
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MAIL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional temporary key for rotating credentials encrypted with an older MAIL_ENCRYPTION_KEY.
# Remove after the startup migration reports no skipped legacy credentials.
MAIL_ENCRYPTION_LEGACY_KEY=
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
APP_BASE_URL=https://tasks.example.com
ALLOWED_ORIGIN=https://tasks.example.com

# ── SMTP Mail Configuration ──────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Tran Le Tasks <noreply@tranlecorp.com.vn>"
# Optional exact host allowlist for approved custom/internal mail servers (comma-separated).
# Example for the built-in Poste mail provider: MAIL_ALLOWED_CUSTOM_HOSTS=tranle_mailserver
MAIL_ALLOWED_CUSTOM_HOSTS=
# Never set MAIL_ALLOW_INSECURE_TLS=true in production; certificate checks are mandatory.

# ── Frontend Build-time Variables ────────────────────────────────────────────
# Do not put provider API keys in VITE_* variables; they are exposed to browsers.
